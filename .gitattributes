# Unity serializes its YAML assets with LF. Pin LF in the working tree so the
# Editor rewriting an asset does not show up as a line-ending-only change for
# contributors whose Git uses core.autocrlf=true.
*.anim                text eol=lf
*.asset               text eol=lf
*.brush               text eol=lf
*.controller          text eol=lf
*.flare               text eol=lf
*.fontsettings        text eol=lf
*.giparams            text eol=lf
*.guiskin             text eol=lf
*.lighting            text eol=lf
*.mask                text eol=lf
*.mat                 text eol=lf
*.meta                text eol=lf
*.mixer               text eol=lf
*.overrideController  text eol=lf
*.physicMaterial      text eol=lf
*.physicsMaterial2D   text eol=lf
*.playable            text eol=lf
*.prefab              text eol=lf
*.preset              text eol=lf
*.renderTexture       text eol=lf
*.shadervariants      text eol=lf
*.spriteatlas         text eol=lf
*.spriteatlasv2       text eol=lf
*.terrainlayer        text eol=lf
*.unity               text eol=lf
